# CT223 — Lia Job Search runtime environment template
#
# Development template only. Production deployment canonical file:
#   /opt/lia-job-search/runtime.env  (mode 0600, owner root:root)
# NEVER commit real secrets.

# --- Bifrost (CT109) — server-side inference authority -----------------------
# Todas as chamadas de IA passam por CT223 -> lib/inference/bifrost.ts -> CT109.
# A chave virtual (VK) é lida apenas no servidor e nunca é enviada ao navegador.
BIFROST_BASE_URL=
BIFROST_VIRTUAL_KEY=
BIFROST_MODEL_DEFAULT=
BIFROST_MODEL_REVIEW=

# --- Persistent data directory ----------------------------------------------
# Container value:
#   LIA_DATA_DIR=/app/data
# Host mapping (bind mount):
#   /opt/lia-job-search/data:/app/data
LIA_DATA_DIR=/app/data

# --- Build/run identity (informational, exposed via /api/health) -------------
APP_COMMIT=
