# CT223 — Lia Job Search runtime environment template
#
# Development template only. Production deployment canonical file:
#   /opt/lia-job-search/runtime.env  (mode 0600, owner root:root)
# NEVER commit real secrets.

# --- Bifrost (CT109) — server-side inference authority -----------------------
# Todas as chamadas de IA passam por CT223 -> lib/inference/bifrost.ts -> CT109.
# A chave virtual (VK) é lida apenas no servidor e nunca é enviada ao navegador.
BIFROST_BASE_URL=
BIFROST_VIRTUAL_KEY=
BIFROST_MODEL_DEFAULT=
BIFROST_MODEL_REVIEW=

# --- Persistent data directory ----------------------------------------------
# Container value:
#   LIA_DATA_DIR=/app/data
# Host mapping (bind mount):
#   /opt/lia-job-search/data:/app/data
LIA_DATA_DIR=/app/data

# --- Auth (Better Auth + OAuth) — CT224 --------------------------------------
# Base URL desta instalação como vista pelo browser/proxy.
#   dev:  http://localhost:3000
#   prod: https://<hostname-tailscale>   (exatamente o origin que o proxy expõe)
BETTER_AUTH_URL=
# Segredo de sessão do Better Auth. Gere com:  openssl rand -base64 32
AUTH_SECRET=
# GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps):
#   Homepage URL:  <BETTER_AUTH_URL>
#   Callback URL:  <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client ID):
#   Authorized redirect URI:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allowlist opcional (single-user): só estes e-mails podem entrar. Vazio = liberado.
# Comma-separated, sem espaços. Ex.: AUTH_ALLOWED_EMAIL=voce@gmail.com
AUTH_ALLOWED_EMAIL=

# --- Build/run identity (informational, exposed via /api/health) -------------
APP_COMMIT=
